[Unit]
Description=ChequeMate FastAPI backend
After=network.target

[Service]
User=chequemate
WorkingDirectory=/opt/chequemate
EnvironmentFile=/opt/chequemate/.env
ExecStart=/opt/chequemate/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
