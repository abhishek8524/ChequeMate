# IP-only mode: plain HTTP on port 80, no domain needed.
# When you have a domain (A record -> server IP), replace ":80" with "yourdomain.com, www.yourdomain.com"
# and Caddy will get an HTTPS certificate automatically.
:80 {
	encode gzip
	reverse_proxy 127.0.0.1:8000 {
		# server.py rate-limits per visitor using this header
		header_up CF-Connecting-IP {remote_host}
	}
}
