# Domain mode: Caddy gets and renews HTTPS certificates automatically.
# Needs DNS A records for chequemate.work and www.chequemate.work -> the server IP.
# (For plain HTTP on the IP only, replace the first line with ":80".)
chequemate.work, www.chequemate.work {
	encode gzip
	reverse_proxy 127.0.0.1:8000 {
		# server.py rate-limits per visitor using this header
		header_up CF-Connecting-IP {remote_host}
	}
}
